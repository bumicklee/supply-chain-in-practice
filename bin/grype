#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
mkdir -p .lab/grype-db .lab/grype-tmp
exec docker run --rm \
  --user "$(id -u):$(id -g)" \
  -v "$PWD:/work" -v "$PWD/.lab/grype-tmp:/tmp" -w /work \
  -e GRYPE_DB_CACHE_DIR=/work/.lab/grype-db \
  -e GRYPE_DB_AUTO_UPDATE="${GRYPE_DB_AUTO_UPDATE:-false}" \
  -e GRYPE_DB_VALIDATE_AGE="${GRYPE_DB_VALIDATE_AGE:-false}" \
  anchore/grype@sha256:013e16ae96bd64108973e3e9fecec63f7ff276358d34c46c25d33e2aac96539f "$@"
